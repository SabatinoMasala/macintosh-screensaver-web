reveal:

	start simultaneous
		let scene = "reveal"
		let ramp = "Right"
		camera to -22.5, 45
		scroll to 80, 73
		mouse to 0, 342
	end simultaneous

	scroll to 300, 73 over 22 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------
